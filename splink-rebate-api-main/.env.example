# Application Configuration
APP_ENV=local
BASE_URL=http://localhost
PORT=4000

DB_NAME=database_name              # Name of the database
DB_USER=database_user              # Username for the database
DB_PASSWORD=database_password      # Password for the database user
DB_HOST=database_host              # Host of the database
DB_DIALECT=postgres                # Database dialect (PostgreSQL in this case)
DB_PORT=5432                       # Port for the database (default for PostgreSQL is 5432)

# SSH Tunnel
USE_SSH_TUNNEL=false               # set true if SSH tunnel is required to connect with DB
DB_SSH_LOCAL_PORT=5433             # Local port for the tunnel

SSH_HOST=123.12.123.12             # Host for the SSH tunnel
SSH_USERNAME=username              # Username for the SSH tunnel
SSH_KEY_PATH=../key.pem            # Path to the SSH key file

# Security keys generated on 2024-11-05T12:46:10.662Z
# WARNING: Never commit this file to version control
# WARNING: Use different secrets for each environment (development, staging, production)

FRONTEND_URL = "http://localhost:3000" # URL of the Next JS application

GOOGLE_APP_USER = 'google-account@gmail.com' # Google app user email
GOOGLE_APP_PASS = 'aaaa bbbb cccc dddd' # Google app password

# JSON Web Token (JWT) secrets
JWT_SECRET=YOUR_VALUE_HERE
REFRESH_TOKEN_SECRET=YOUR_VALUE_HERE

# Token expiration settings
INVITE_JWT_EXPIRES_IN=24h              # Options: 15m, 30m, 1h, 2h, etc.
JWT_EXPIRATION=24h # Options: 15m, 30m, 1h, 2h, etc.
JWT_LONG_EXPIRATION=24h # Options: 15m, 30m, 1h, 2h, etc.
REFRESH_TOKEN_EXPIRATION=24h # Options: 1d, 7d, 30d, etc.

# Validation hashes (DO NOT REMOVE - used to detect accidental secret changes)
# JWT_SECRET_HASH=YOUR_VALUE_HERE
# REFRESH_TOKEN_SECRET_HASH=YOUR_VALUE_HERE

# Environment (uncomment one)
# NODE_ENV=YOUR_VALUE_HERE
# NODE_ENV=YOUR_VALUE_HERE
# NODE_ENV=YOUR_VALUE_HERE

# Optional: Additional security settings
# TOKEN_ISSUER=YOUR_VALUE_HERE
# TOKEN_AUDIENCE=YOUR_VALUE_HERE
# COOKIE_SECURE=YOUR_VALUE_HERE# Set to true in production
# COOKIE_SAME_SITE=YOUR_VALUE_HERE# Options: strict, lax, none

# SMTP Settings
MAIL_HOST=YOUR_VALUE_HERE
MAIL_PORT=YOUR_VALUE_HERE
MAIL_USERNAME=YOUR_VALUE_HERE
MAIL_PASSWORD=YOUR_VALUE_HERE
MAIL_FROM_EMAIL="no-reply@app.splinktechnologies.com"
MAIL_FROM_NAME="Splink"

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_REGION="us-east-2" # default region for now
AWS_FILE_BUCKET=""

# New Relic
NEW_RELIC_LICENSE_KEY='your_license_key_here'
NEW_RELIC_APP_NAME='Splink Rebate API - Dev'

# Redis
REDIS_URL=redis://localhost:6379

# Redis URL for development environment
REDIS_URL=redis://localhost:6379

# Redis URL for production environment
REDIS_URL=rediss://localhost:6379

# Caching: set to False to disable caching on local
USE_API_CACHING=false

CHAIN_PROGRAMS_ENABLED_FOR_DISTRIBUTOR_IDS = 1,2,3,4

HLA_REPORT_ALLOWED_IPS = "127.0.0.1, ::1"

S3_BUCKET_NAME = ""

S3_AWS_REGION = ""