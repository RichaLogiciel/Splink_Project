{
  "name": "splink-rebate-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "repository": "https://github.com/Splink-Technologies/splink-rebate-api.git",
  "scripts": {
    "test": "jest --config ./jest.config.js",
    "test-watch": "jest --config ./jest.config.js --watch",
    "test:coverage": "jest --config ./jest.config.js --coverage",
    "test:coverage:html": "yarn test:coverage && open coverage/lcov-report/index.html",
    "test:coverage:ci": "jest --config ./jest.config.js --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:watch:coverage": "jest --config ./jest.config.js --watch --coverage",
    "dev": "ts-node -r tsconfig-paths/register start-dev.ts",
    "tunnel": "ts-node src/ssh-tunnel.ts",
    "dev:app": "nodemon --exec ts-node -r tsconfig-paths/register -r ./src/types/index.ts ./src/index.ts",
    "build": "yarn lint && tsc",
    "start": "node dist/index.js",
    "db:setup": "ts-node ./src/dbSetup.ts",
    "migrate": "node scripts/pre-migrate-drop-mv.js && sequelize-cli db:migrate",
    "migrate:one-time-date-fix": "node scripts/dynamic-date-migration.js",
    "migrate:production-date": "node scripts/dynamic-date-migration.js",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "db:create:test": "sequelize-cli db:create --env test",
    "db:migrate:test": "sequelize-cli db:migrate --env test",
    "format": "prettier --write .",
    "lint": "eslint ./src/*",
    "lint:fix": "eslint --fix ./src/*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn test"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:fix"
    ],
    "src/**/*.test.ts": [
      "jest --config ./jest.config.js --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/newrelic": "^9.14.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "@types/pino": "^7.0.5",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-sequelize": "^1.0.4",
    "globals": "^15.11.0",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/client-sqs": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^6.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "fast-csv": "^5.0.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.11.3",
    "newrelic": "^12.13.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.4",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3"
  }
}
