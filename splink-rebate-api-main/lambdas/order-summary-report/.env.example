# Database Configuration (RDS Proxy)
DB_HOST=your-rds-proxy-endpoint.proxy-xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=postgres
DB_SSL=false

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_EMAIL=no-reply@splinktechnologies.com
MAIL_FROM_NAME=Splink

# AWS Configuration
AWS_REGION=us-east-1
